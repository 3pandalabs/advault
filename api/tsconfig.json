{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src"],
  // Tests must not reach dist/. The container image installs production
  // dependencies only, so a compiled test that imports vitest is dead weight at
  // best — and `npm run build` is what produces the image's dist/.
  // tsconfig.test.json type-checks them instead; see the typecheck script.
  "exclude": ["src/**/*.test.ts"]
}
