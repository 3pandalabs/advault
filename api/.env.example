# Postgres. In prod this is the internal connection string for the `advault`
# database on the shared 3pandalabs-postgres instance, as the `advault_app`
# role. Locally it's docker-compose.dev.yml — note port 5434, so it doesn't
# clash with a RentVault/ReceiptCash Postgres on 5432 or RsvpVault's on 5433.
DATABASE_URL=postgres://advault:advault@localhost:5434/advault

# Privileged DDL role used ONLY by db/migrate.ts. LEAVE THIS UNSET — there is
# no role split; advault_app owns its own database. Setting it to a superuser
# creates objects the runtime role can't read (42501).
# MIGRATION_DATABASE_URL=

# HTTP server (API container only; the renderer ignores it)
PORT=8080

# JWT access-token signing secret. Generate with: openssl rand -hex 32
JWT_SECRET=changeme

# Comma-separated CORS origins (web app + local dev)
CORS_ORIGINS=http://localhost:3000,https://advault.3pandalabs.com

# Where the dashboard lives. Used to build the Google OAuth redirect URI, so it
# must EXACTLY match an Authorised redirect URI on the OAuth client — Google
# compares the full string including scheme, port and trailing slash.
WEB_ORIGIN=http://localhost:3000

# Cloudflare R2 (S3-compatible). Bucket must exist first — see infra/r2-setup.md
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=advault-assets
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# AES-256-GCM key for Google Ads refresh tokens at rest. REQUIRED — both
# containers refuse to boot without it, deliberately: a refresh token authorises
# spending an advertiser's budget, so there is no "degrade gracefully and store
# it in plaintext" option. 64 hex characters:
#   openssl rand -hex 32
# Rotating it invalidates every stored token and every advertiser has to
# reconnect their Google Ads account. See infra/google-ads-setup.md.
TOKEN_ENCRYPTION_KEY=

# Bearer token for the ops-only GET /metrics endpoint scraped by the admin page.
# Must match the METRICS_TOKEN secret on the 3pandalabs-admin Worker (one shared
# token across all apps). Leave blank to disable — /metrics then answers 503 and
# nothing else changes.
METRICS_TOKEN=

# --- AI script generation (optional) ----------------------------------------
# Unset means POST /campaigns/:id/creatives/generate falls back to the
# deterministic template in lib/script/fallback.ts. The wizard still works end
# to end; the copy is just formulaic rather than written for the business.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Google Ads (optional; campaigns stay in `draft` until all four are set) --
# Needs a Google Cloud OAuth client AND an approved Google Ads developer token.
# The developer token is the slow part — Basic access is a manual review against
# an existing Manager (MCC) account. See infra/google-ads-setup.md.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
# The Manager (MCC) account that will be the login-customer-id on API calls.
# Digits only, no dashes.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- Renderer (renderer container only) --------------------------------------
# Concurrent ffmpeg encodes. KEEP THIS AT 1 in production: the shared cx33 has
# 4 vCPUs and also runs Postgres, three other API containers and the monitoring
# stack.
RENDER_CONCURRENCY=1
# How often the worker polls render_jobs when the queue came back empty, in ms.
RENDER_POLL_INTERVAL_MS=5000
# Scratch directory for frames and intermediate files. Must be writable by the
# container's unprivileged `advault` user.
RENDER_WORK_DIR=/tmp/advault-render

# Font files used by the drawtext filter. Defaults match the alpine paths in
# Dockerfile.renderer; override only for local development, where fonts live
# elsewhere (macOS/Debian/Alpine all differ).
RENDER_FONT_REGULAR=/usr/share/fonts/dejavu/DejaVuSans.ttf
RENDER_FONT_BOLD=/usr/share/fonts/dejavu/DejaVuSans-Bold.ttf
