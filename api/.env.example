# Postgres. In prod this is the internal connection string for the `advault`
# database on the shared 3pandalabs-postgres instance, as the `advault_app`
# role. Locally it's docker-compose.dev.yml — note port 5434, so it doesn't
# clash with a RentVault/ReceiptCash Postgres on 5432 or RsvpVault's on 5433.
DATABASE_URL=postgres://advault:advault@localhost:5434/advault

# Privileged DDL role used ONLY by db/migrate.ts. LEAVE THIS UNSET — there is
# no role split; advault_app owns its own database. Setting it to a superuser
# creates objects the runtime role can't read (42501).
# MIGRATION_DATABASE_URL=

# HTTP server (API container only; the renderer ignores it)
PORT=8080

# JWT access-token signing secret. Generate with: openssl rand -hex 32
JWT_SECRET=changeme

# Comma-separated CORS origins (web app + local dev)
CORS_ORIGINS=http://localhost:3000,https://advault.3pandalabs.com

# Where the dashboard lives. Used to build the Google OAuth redirect URI, so it
# must EXACTLY match an Authorised redirect URI on the OAuth client — Google
# compares the full string including scheme, port and trailing slash.
WEB_ORIGIN=http://localhost:3000

# Cloudflare R2 (S3-compatible). Bucket must exist first — see infra/r2-setup.md
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=advault-assets
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# AES-256-GCM key for Google Ads refresh tokens at rest. REQUIRED — both
# containers refuse to boot without it, deliberately: a refresh token authorises
# spending an advertiser's budget, so there is no "degrade gracefully and store
# it in plaintext" option. 64 hex characters:
#   openssl rand -hex 32
# Rotating it invalidates every stored token and every advertiser has to
# reconnect their Google Ads account. See infra/google-ads-setup.md.
TOKEN_ENCRYPTION_KEY=

# Bearer token for the ops-only GET /metrics endpoint scraped by the admin page.
# Must match the METRICS_TOKEN secret on the 3pandalabs-admin Worker (one shared
# token across all apps). Leave blank to disable — /metrics then answers 503 and
# nothing else changes.
METRICS_TOKEN=

# --- AI script generation (optional) ----------------------------------------
# Unset means POST /campaigns/:id/creatives/generate falls back to the
# deterministic template in lib/script/fallback.ts. The wizard still works end
# to end; the copy is just formulaic rather than written for the business.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Google Ads (optional; campaigns stay in `draft` until all four are set) --
# Needs a Google Cloud OAuth client AND an approved Google Ads developer token.
# The developer token is the slow part — Basic access is a manual review against
# an existing Manager (MCC) account. See infra/google-ads-setup.md.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
# The Manager (MCC) account that will be the login-customer-id on API calls.
# Digits only, no dashes.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- Renderer (renderer container only) --------------------------------------
# Concurrent ffmpeg encodes. KEEP THIS AT 1 in production: the shared cx33 has
# 4 vCPUs and also runs Postgres, three other API containers and the monitoring
# stack.
RENDER_CONCURRENCY=1
# How often the worker polls render_jobs when the queue came back empty, in ms.
RENDER_POLL_INTERVAL_MS=5000
# Scratch directory for frames and intermediate files. Must be writable by the
# container's unprivileged `advault` user.
RENDER_WORK_DIR=/tmp/advault-render

# Font files used by the drawtext filter. Defaults match the alpine paths in
# Dockerfile.renderer; override only for local development, where fonts live
# elsewhere (macOS/Debian/Alpine all differ).
RENDER_FONT_REGULAR=/usr/share/fonts/dejavu/DejaVuSans.ttf
RENDER_FONT_BOLD=/usr/share/fonts/dejavu/DejaVuSans-Bold.ttf

# --- Google Ads MCC (managed child accounts) --------------------------------
# The manager account's OWN refresh token, AES-256-GCM encrypted with
# TOKEN_ENCRYPTION_KEY. One credential for the whole platform — child accounts
# need no per-advertiser grant. Mint it once; see infra/google-ads-setup.md.
# Unset means managed provisioning answers 503 and the own-OAuth path still works.
GOOGLE_ADS_MCC_REFRESH_TOKEN_CIPHERTEXT=

# --- Payments ---------------------------------------------------------------
# Routed by currency: Razorpay for INR (UPI/netbanking, which is how most Indian
# SMBs pay), Stripe for USD. With neither set, the manual provider takes over so
# the whole billing path stays testable — but only an admin can credit a wallet.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- AI: script -------------------------------------------------------------
# claude (default, already integrated) | deepseek | openai. Falls back to claude
# if the chosen provider has no key, and to the deterministic template if that
# also fails. Never throws.
SCRIPT_PROVIDER=claude
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# --- AI: motion clips (optional) --------------------------------------------
# Unset means the renderer uses its Ken Burns pan on the still photo — the
# pipeline that already ships and is verified. Polish, never load-bearing.
MOTION_PROVIDER=
KLING_API_KEY=
LUMA_API_KEY=
# Cost ceiling: how many scenes may get a generated clip. Motion is metered per
# generation and is ~95% of the marginal cost of an ad, so this caps a
# five-scene script at the same vendor spend as a three-scene one. Scenes past
# the cap render as Ken Burns stills.
MOTION_MAX_CLIPS=3

# --- AI: voiceover (optional) -----------------------------------------------
# edge-tts is free and needs no account, which is why it is the default.
# Unset/disabled means a silent cut.
VOICE_PROVIDER=
ELEVENLABS_API_KEY=
# DISABLE_EDGE_TTS=1

# --- Creative generation ceiling --------------------------------------------
# Creatives one advertiser may generate per rolling 24h. A SPEND control, not an
# abuse one: vendor cost for motion/voice lands before any ad spend, so it sits
# outside the prepaid wallet that guards Google.
MAX_CREATIVES_PER_DAY=20

# --- Spend sync (renderer container) ----------------------------------------
# How often to reconcile Google spend into wallets and pause dry campaigns.
SPEND_SYNC_INTERVAL_MS=3600000

# --- Subscriptions: the revenue model ---------------------------------------
# With none of these set the `manual` provider takes over: subscriptions are
# created, invoices open, and an admin marks them paid. That is deliberate — the
# whole lifecycle (invoice, ledger `fee` row, entitlement, dunning, renewal) is
# then exercisable before any vendor account exists.
#
# Paddle is the MERCHANT OF RECORD rail and is preferred for the offer line.
# That is a tax decision: as the seller, Paddle carries India's OIDAR GST
# registration and monthly GSTR-5A filing. Selling the offer subscription
# direct obliges AdVault to register for Indian GST from the FIRST rupee —
# there is no turnover threshold for a foreign supplier — so the ~5% Paddle
# takes is the price of not owning that registration while we are still finding
# out whether anyone will subscribe at all.
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_IN_OFFER=
PADDLE_PRICE_US_OFFER=
PADDLE_PRICE_IN_MANAGED=
PADDLE_PRICE_US_MANAGED=

# Direct rails for the managed line. Plan/price objects are created in each
# vendor's dashboard; lib/pricing stays the source of truth for the AMOUNT, and
# a drift between the two surfaces as the amount mismatch the webhook refuses.
RAZORPAY_PLAN_IN_OFFER=
RAZORPAY_PLAN_IN_MANAGED=
STRIPE_PRICE_US_OFFER=
STRIPE_PRICE_US_MANAGED=

# --- WhatsApp: the monthly offer loop ---------------------------------------
# The product's real interface. A shop owner will not open a dashboard on the
# 1st of the month; they will reply to a message. Unset means the dashboard
# fallback at /dashboard/offer is the only path — cycles still open, no messages
# go out.
#
# The monthly prompt is unsolicited by definition, so Meta will only deliver it
# as a PRE-APPROVED TEMPLATE. Register both templates in Meta's console before
# switching this on; free text only works inside the 24 hours after a customer
# replies.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_OFFER_PROMPT=monthly_offer_prompt
WHATSAPP_TEMPLATE_OFFER_REMINDER=monthly_offer_reminder

# --- Offer/renewal sweeps (renderer container) ------------------------------
# Opens monthly offer cycles, sends prompts and reminders, opens renewal
# invoices, and pauses campaigns whose offer deadline has passed.
OFFER_SWEEP_INTERVAL_MS=3600000

# --- AI: cinematic add-on, TEXT-to-video (optional) --------------------------
# This is the PAID one-off product, and unlike every other AI provider here it
# has NO fallback: unset means /add-ons reports available:false and the checkout
# refuses, rather than quietly selling a cheaper ad. Renderer container only.
#
# GEMINI_API_KEY is a Google AI Studio key with Cloud billing enabled. It is NOT
# the Google Ads OAuth credential elsewhere in this file — different product,
# different account.
CINEMATIC_PROVIDER=
GEMINI_API_KEY=
# Veo model ids move faster than this repo. Fast rather than Standard by
# default: 4x cheaper per second, and 720p is not what makes an ad look cheap.
VEO_MODEL=
# Kling text-to-video reuses KLING_API_KEY / KLING_API_BASE from the motion
# section above; only the model differs.
KLING_T2V_MODEL=
